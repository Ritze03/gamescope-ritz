#version 460

// cs_effects_v2_box2.comp -- Adaptive Brightness V2's Stage 2, third pass
// (2026-09-14): the guided filter's SECOND box, smoothing the raw (a, b)
// coefficients cs_effects_v2_box1.comp wrote (plan 4.5's "a-bar, b-bar =
// box_r(a), box_r(b)"). Same non-separable 2D box as box1, same radius, and
// the same reasoning for using one pass instead of the plan's h/v pair --
// see that file's header.
//
// Reads the OTHER half of the ping-pong pair from box1 and writes back to
// the buffer cs_effects_v2_down.comp used (box1 already moved on, so there
// is no hazard); cs_effects_layer0.comp's v2_coef_sample() then reads this
// one, bilinearly, as B(p) = a-bar * Y(p) + b-bar.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"
#include "effects_common.h"
#include "effects_curve.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

vec2 v2_ab_fetch(ivec2 t, ivec2 sz)
{
    return texelFetch(s_samplers[VKR_EFFECTS_V2_SLOT], clamp(t, ivec2(0), sz - ivec2(1)), 0).rg;
}

void main()
{
    ivec2 p  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = textureSize(s_samplers[VKR_EFFECTS_V2_SLOT], 0);
    if (p.x >= sz.x || p.y >= sz.y)
        return;

    int r = max(int(u_v2Radius), 0);
    vec2 sum = vec2(0.0);
    float n = 0.0;
    for (int j = -r; j <= r; j++)
    {
        for (int i = -r; i <= r; i++)
        {
            sum += v2_ab_fetch(p + ivec2(i, j), sz);
            n   += 1.0;
        }
    }

    vec2 ab = sum / max(n, 1.0);
    imageStore(dst, p, vec4(clamp(ab.x, 0.0, 1.0), clamp(ab.y, 0.0, 1.0), 0.0, 1.0));
}
