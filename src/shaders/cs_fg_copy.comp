#version 460

// cs_fg_copy.comp -- one plain texel-for-texel copy of the game's frame into
// the frame-generation host's PRIVATE ring (src/FrameGen/FrameGenHost.cpp).
//
// Why a shader and not vkCmdCopyImage: the game's frame is an imported dmabuf
// created SAMPLED-only (no TRANSFER_SRC), and it may be XRGB/ARGB (B8G8R8A8)
// or XBGR/ABGR (R8G8B8A8) while the ring is always one fixed B8G8R8A8_UNORM
// format. Sampling gives the logical rgba whatever the channel order, so the
// ring never needs a per-format variant; the "X" formats' undefined alpha is
// replaced by 1.0 (the FrameGen library reads rgb only).
//
// Slot 0 is bound the way every layer-0 pass binds it: raw UNORM view (values
// still encoded -- NOT the _SRGB view, which would decode them and the library
// would then see the wrong luma), unnormalised nearest sampler, so this is an
// exact copy, never a filter.

#extension GL_GOOGLE_include_directive : require

#include "descriptor_set.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(dst))))
        return;

    imageStore(dst, p, vec4(texelFetch(s_samplers[0], p, 0).rgb, 1.0));
}
