#version 460

// cs_effects_measure.comp -- Adaptive Brightness's measure/adapt half: ONE
// workgroup that measures the graded base layer's luminance statistics and
// folds them into row 0 of the persistent HISTORY_TEX_W x HISTORY_TEX_H
// history (whose remaining rows are the local map, below), which
// cs_effects_layer0.comp then reads per pixel in the same frame. Compiled at
// build time like every other compute shader here (DECISIONS.md #27); the
// host records it immediately before the per-pixel pass, on the same
// command buffer, whenever the effects pre-pass runs at all.
//
// Four statistics, all on the graded ENCODED luma of a 128x128 grid of taps
// (16x16 threads, 8x8 per thread, 16384 total) over the whole image:
//   HISTORY_MEAN  arithmetic mean                        -- Whole-image mode's input
//   HISTORY_P2    mean of the taps ranked  1 %.. 3 % (shadows)    \
//   HISTORY_P50   mean of the taps ranked 25 %..75 % (mid-tones)   > Dynamic mode's inputs
//   HISTORY_P98   mean of the taps ranked 97 %..99 % (lights)     /
// The three ranked statistics come from a 64-bin shared-memory histogram of
// counts AND value sums (two atomicAdds per tap, then invocation 0 walks
// the 64 bins once). No buffer atomics, no second pass, no intermediate
// texture -- the histogram lives entirely in this workgroup's shared memory.
//
// WHY RANK-WINDOW MEANS, NOT PERCENTILES (2026-09-07, "the whole image
// pulsates"). A percentile is a rank CUT: the value of the k-th brightest
// tap. On a histogram with an empty stretch -- a dark scene with a few
// lights, a half-sky/half-ground view -- the cut sits in the gap, and a
// single tap moving from one mode to the other flips it from the top of
// the lower mode to the bottom of the upper one. Measured with the
// effects_ab_log readback on a 2 %-lights scene under a 3 px/frame pan: the
// raw 98th percentile telegraphed 0.217 <-> 0.636 (107 codes) frame to
// frame, the EMA turned that into a 16-code wander of the smoothed value,
// and at max_gain 4 the gain breathed 3.19..4.00 -- the pulse the user saw.
// A 50/50 split did the same to the median (98 codes raw, gamma 0.86..1.18).
// The mean of the taps in a rank window centred on the same percentile is
// the same number wherever the histogram is dense (in-bin uniformity is the
// same assumption the old interpolation made) but is CONTINUOUS in the tap
// counts: one tap crossing a gap of width g moves an 82-tap window's mean by
// g / 82, not by g. Measured after: the same scene's raw p98 spread fell
// from 107 to under 10 codes and the smoothed gain's swing from 25 % to
// under 2 %. Nothing about the EMA, dt, or the curve changed, so
// adaptation is exactly as fast as before. The grid went 64x64 -> 128x128
// at the same time: what is left after the cliff is plain sampling noise,
// which only more taps reduce (std ~ 1/sqrt(taps)), and four times the
// fetches in this one workgroup is still far below a millisecond. See
// shader-effects.md.
//
// Ported from the retired reshade/Shaders/gamescope-ritz.fx (MeasureLuminance
// + PS_AdaptiveBrightnessAdapt), which was measured live to converge on its
// own model, so the ADAPT maths is unchanged and applied per statistic:
//   tau   = measured > adapted ? up : down
//   alpha = 1 - exp(-dt / max(tau, 0.001))
//   adapted' = lerp(adapted, measured, alpha)
// `up` is the time constant while a statistic RISES (the scene got brighter,
// the picture will be dimmed), `down` while it FALLS (the scene got darker,
// the picture will be lifted). Each tap is graded exactly as the apply pass
// grades its pixels (effects_common.h's grade() -- the .fx measured its
// post-Shadow-Control/Saturation texture, so this matches its input; the
// NEW Vibrancy effect, added 2026-09-08, runs inside grade() too, so its
// output is measured the same way).
//
// Every statistic is tracked whatever the mode, and this pass never looks at
// EFFECT_ADAPTIVE_BRIGHTNESS or EFFECT_AB_DYNAMIC -- only the apply pass
// gates the visible effect -- so switching the effect on, or between modes,
// is instant. The host dispatches this pass whenever the pre-pass runs (any
// effect on); see rendervulkan.cpp for the reset-on-resume rule.
//
// THE LOCAL MAP (Local adaptation, 2026-09-07). Besides the four global
// statistics this pass also writes a 16x16 grid of smoothed LOCAL mean
// luminances into rows 1..16 of the same history texture (effects_common.h's
// AB_LOCAL_*), which the apply pass samples bilinearly to give each pixel a
// curve fitted to its own part of the frame. It is free in taps: thread
// (tx, ty) already owns exactly the 8x8 tap block covering image cell
// (tx, ty), so the per-thread sum it computes for the mean's tree reduction
// IS that cell's mean. What it adds is a separable binomial blur over the
// 16x16 grid in shared memory (blur_local_once() below, run twice) and one
// EMA + imageStore per thread. The blur is the halo control and the EMA is
// the flicker control -- same asymmetric time constants as every other
// statistic, so a local cell can no more pulse than the global gain can.
//
// Self-sampling: the history is bound BOTH as sampler
// VKR_EFFECTS_HISTORY_SLOT and as this pass's storage target `dst`. Row 0
// (the statistics) is touched by invocation 0 alone, and its fetches
// precede its stores in program order. Every OTHER invocation touches
// exactly one local-map texel, its own, and reads it before writing it --
// no two invocations address the same texel, so there is no hazard between
// invocations either way. The layout is GENERAL for both bindings. See
// rendervulkan.cpp's pre-pass block for the barrier story between this
// dispatch, the apply dispatch, and the next frame.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"
#include "effects_common.h"

layout(
  local_size_x = 16,
  local_size_y = 16,
  local_size_z = 1) in;

const uint THREADS_PER_AXIS = 16u;   // == local_size_x == local_size_y
const uint TAPS_PER_THREAD_AXIS = 8u;
const uint GRID = THREADS_PER_AXIS * TAPS_PER_THREAD_AXIS;   // 128 taps per axis
const uint THREAD_COUNT = THREADS_PER_AXIS * THREADS_PER_AXIS;
const uint TAP_COUNT = GRID * GRID;                          // 16384
const uint HIST_BINS = 64u;

shared float s_sum[THREAD_COUNT];
shared uint  s_hist[HIST_BINS];      // taps per bin
shared uint  s_histSum[HIST_BINS];   // sum of the taps' luma per bin, fixed point (x LUMA_FIXED)

// The local luminance map (effects_common.h's AB_LOCAL_*). One cell per
// THREAD -- thread (tx, ty) owns exactly the 8x8 tap block covering image
// cell (tx, ty), so its own tap sum is the cell's mean and the map costs no
// extra fetches. AB_LOCAL_GRID is 16 == THREADS_PER_AXIS by construction;
// s_localTmp is the separable blur's intermediate.
shared float s_local[THREAD_COUNT];
shared float s_localTmp[THREAD_COUNT];

// Fixed-point scale for s_histSum: 16384 taps x 65535 < 2^32.
const float LUMA_FIXED = 65535.0;

// The mean luma of the taps ranked [lo, hi) when sorted from black
// (rank = fraction * TAP_COUNT). Walks the bins; the part of a bin that
// falls inside the window contributes that many taps at the bin's own
// mean value -- the same in-bin uniformity the old percentile interpolation
// assumed, so on a dense histogram this IS the interpolated percentile of
// the window's centre. Where the histogram has a gap, it is continuous in
// the counts where a rank cut is not (see the header).
float histogram_window_mean(float lo, float hi)
{
    float cum = 0.0;
    float total = 0.0;
    float taps = 0.0;
    for (uint b = 0u; b < HIST_BINS; b++)
    {
        float n = float(s_hist[b]);
        if (n > 0.0)
        {
            float k = clamp(min(cum + n, hi) - max(cum, lo), 0.0, n);
            if (k > 0.0)
            {
                total += k * (float(s_histSum[b]) / (LUMA_FIXED * n));
                taps += k;
            }
            cum += n;
        }
        if (cum >= hi)
            break;
    }
    return (taps > 0.0) ? clamp(total / taps, 0.0, 1.0) : 0.0;
}

// ---- The local map's spatial smoothing -------------------------------
//
// A separable 5-tap binomial [1 4 6 4 1]/16 on each axis, run once per entry
// of BLUR_STRIDES with its taps spread that many cells apart (the a-trous
// trick: a stride-k pass costs the same five taps but carries variance k^2,
// so a wide Gaussian is three cheap passes instead of twenty-odd). Edges are
// clamped to the outermost cell, so the kernel stays normalised everywhere.
// Total variance 4^2 + 2^2 + 1 + 1 = 22, i.e. sigma ~= 4.7 of the 16 cells
// on an axis -- getting on for a THIRD of the frame.
//
// WHY SO ABSURDLY WIDE. This is the halo control, and it was set by
// measurement, not taste. A local tone operator's artefact is a glow around
// a dark object on a bright field, and its size is set by how well the
// luminance map resolves the object's outline. Measured on a flat 200 field
// with a flat 10 box a quarter of the frame across (the halo scenes in
// tests/effects_scene_client.c), at Local adaptation 100 %:
//
//   sigma 1.4 cells   the field reads 246 beside the box and 189 far away
//                     -- a 57-code white glow, unmistakable in the capture
//   sigma 2.2 cells   243 / 190, 53 codes. Barely better: right AT a step
//                     edge a blurred step always sits halfway between the
//                     two sides, whatever the sigma. Widening the ramp does
//                     not lower it.
//   sigma 4.7 cells   219 / 204, 15 codes -- and 8 at the 50 % default. The
//                     kernel is now far larger than the box, so the box
//                     contributes only its share of the kernel's AREA
//                     instead of half a step. In the capture the glow is
//                     gone; what is left reads as a faint, frame-wide
//                     shading. See shader-effects.md for the profiles.
//
// And it costs the case this exists for almost nothing, because that case is
// BIG: a half-dark/half-bright frame is an 8-cell feature, and a Gaussian
// this wide still passes ~90 % of an 8-cell step while passing ~30 % of a
// 4-cell box. Measured, on the split scene at 100 %: widening the blur from
// sigma 1.4 to 4.7 cost the dark half's lift 34 -> 28 codes (a fifth) and
// removed three quarters of the halo. The operator is deliberately incapable
// of resolving an object's outline, and just capable of resolving which half
// of the screen you are in. That asymmetry IS the design.
//
// `Why binomial and not a box:` a non-negative, symmetric, unimodal kernel
// maps a step to a MONOTONE ramp -- it cannot overshoot, so the profile
// across a hard edge has no ring by construction, not just by measurement.
const int BLUR_STRIDES[4] = int[4](4, 2, 1, 1);
const float BLUR_W0 = 6.0 / 16.0;
const float BLUR_W1 = 4.0 / 16.0;
const float BLUR_W2 = 1.0 / 16.0;

int local_cell( int x, int y )
{
    return clamp(y, 0, AB_LOCAL_GRID - 1) * AB_LOCAL_GRID + clamp(x, 0, AB_LOCAL_GRID - 1);
}

// One horizontal + one vertical pass over s_local, in place, with the taps
// `stride` cells apart. Every invocation reaches every barrier: the control
// flow here is uniform.
void blur_local_once(int stride)
{
    int cx = int(gl_LocalInvocationID.x);
    int cy = int(gl_LocalInvocationID.y);
    int s1 = stride, s2 = 2 * stride;

    float h = BLUR_W0 *  s_local[local_cell(cx,      cy)]
            + BLUR_W1 * (s_local[local_cell(cx - s1, cy)] + s_local[local_cell(cx + s1, cy)])
            + BLUR_W2 * (s_local[local_cell(cx - s2, cy)] + s_local[local_cell(cx + s2, cy)]);
    memoryBarrierShared();
    barrier();
    s_localTmp[local_cell(cx, cy)] = h;
    memoryBarrierShared();
    barrier();

    float v = BLUR_W0 *  s_localTmp[local_cell(cx, cy)]
            + BLUR_W1 * (s_localTmp[local_cell(cx, cy - s1)] + s_localTmp[local_cell(cx, cy + s1)])
            + BLUR_W2 * (s_localTmp[local_cell(cx, cy - s2)] + s_localTmp[local_cell(cx, cy + s2)]);
    memoryBarrierShared();
    barrier();
    s_local[local_cell(cx, cy)] = v;
    memoryBarrierShared();
    barrier();
}

// One EMA step toward `measured` from the stored value, or a straight write
// on a reset frame. The stored value only ever holds what this shader wrote,
// all in 0..1, but a NaN or inf would poison every later frame through the
// EMA, so snap to the measurement rather than propagate one.
float adapt_at(ivec2 texel, float measured)
{
    if ((u_flags & EFFECT_RESET_HISTORY) != 0u)
        return measured;

    float adapted = history_read_at(texel);
    if (isnan(adapted) || isinf(adapted))
        adapted = measured;
    adapted = clamp(adapted, 0.0, 1.0);

    float tau   = (measured > adapted) ? u_abUp : u_abDown;
    float alpha = clamp(1.0 - exp(-u_abDt / max(tau, 0.001)), 0.0, 1.0);
    return mix(adapted, measured, alpha);
}

float adapt(int which, float measured)
{
    return adapt_at(ivec2(which, 0), measured);
}

void main()
{
    ivec2 size = textureSize(s_samplers[0], 0);

    if (gl_LocalInvocationIndex < HIST_BINS)
    {
        s_hist[gl_LocalInvocationIndex] = 0u;
        s_histSum[gl_LocalInvocationIndex] = 0u;
    }
    memoryBarrierShared();
    barrier();

    // Each thread owns an 8x8 block of the 128x128 tap grid; tap (gx, gy) sits
    // at the centre of grid cell (gx, gy) over the full image, clamped so a
    // tiny image never fetches out of bounds.
    uvec2 base = gl_LocalInvocationID.xy * TAPS_PER_THREAD_AXIS;
    float sum = 0.0;
    for (uint y = 0u; y < TAPS_PER_THREAD_AXIS; y++)
    {
        for (uint x = 0u; x < TAPS_PER_THREAD_AXIS; x++)
        {
            vec2 g = vec2(base + uvec2(x, y)) + 0.5;
            ivec2 p = ivec2(g / float(GRID) * vec2(size));
            p = clamp(p, ivec2(0), size - ivec2(1));
            float luma = clamp(effects_luma(grade(texelFetch(s_samplers[0], p, 0).rgb)), 0.0, 1.0);
            sum += luma;
            uint bin = min(uint(luma * float(HIST_BINS)), HIST_BINS - 1u);
            atomicAdd(s_hist[bin], 1u);
            atomicAdd(s_histSum[bin], uint(luma * LUMA_FIXED + 0.5));
        }
    }

    s_sum[gl_LocalInvocationIndex] = sum;
    // This thread's own 8x8 tap block IS image cell (tx, ty) -- see
    // effects_common.h's AB_LOCAL_* note. Free: `sum` is already computed.
    s_local[gl_LocalInvocationIndex] = sum / float(TAPS_PER_THREAD_AXIS * TAPS_PER_THREAD_AXIS);
    memoryBarrierShared();
    barrier();

    // Tree reduction; uniform control flow, so the barriers are legal.
    for (uint stride = THREAD_COUNT / 2u; stride > 0u; stride >>= 1u)
    {
        if (gl_LocalInvocationIndex < stride)
            s_sum[gl_LocalInvocationIndex] += s_sum[gl_LocalInvocationIndex + stride];
        memoryBarrierShared();
        barrier();
    }

    // ---- The local map: blur, then the same EMA the statistics get ----
    // Every invocation must reach these barriers, so this happens BEFORE
    // the invocation-0 early-out below.
    //
    // Self-sampling is safe for the same reason it is for row 0, one step
    // stronger: each thread reads ONLY its own texel and writes ONLY its
    // own texel, and its read precedes its write in program order. No two
    // invocations touch the same texel at all.
    for (int pass = 0; pass < BLUR_STRIDES.length(); pass++)
        blur_local_once(BLUR_STRIDES[pass]);
    {
        ivec2 texel = ivec2(int(gl_LocalInvocationID.x), AB_LOCAL_ROW + int(gl_LocalInvocationID.y));
        float measured = clamp(s_local[gl_LocalInvocationIndex], 0.0, 1.0);
        imageStore(dst, texel, history_pack(adapt_at(texel, measured)));
    }

    if (gl_LocalInvocationIndex != 0u)
        return;

    const float N = float(TAP_COUNT);
    float mean = clamp(s_sum[0] / N, 0.0, 1.0);
    float p2   = histogram_window_mean(0.01 * N, 0.03 * N);
    float p50  = histogram_window_mean(0.25 * N, 0.75 * N);
    float p98  = histogram_window_mean(0.97 * N, 0.99 * N);

    imageStore(dst, ivec2(HISTORY_MEAN, 0), history_pack(adapt(HISTORY_MEAN, mean)));
    imageStore(dst, ivec2(HISTORY_P2,   0), history_pack(adapt(HISTORY_P2,   p2)));
    imageStore(dst, ivec2(HISTORY_P50,  0), history_pack(adapt(HISTORY_P50,  p50)));
    imageStore(dst, ivec2(HISTORY_P98,  0), history_pack(adapt(HISTORY_P98,  p98)));

    // The raw measurement beside the smoothed value, for the host's debug
    // readback only (effects_common.h, HISTORY_RAW).
    imageStore(dst, ivec2(HISTORY_RAW + HISTORY_MEAN, 0), history_pack(mean));
    imageStore(dst, ivec2(HISTORY_RAW + HISTORY_P2,   0), history_pack(p2));
    imageStore(dst, ivec2(HISTORY_RAW + HISTORY_P50,  0), history_pack(p50));
    imageStore(dst, ivec2(HISTORY_RAW + HISTORY_P98,  0), history_pack(p98));
}
