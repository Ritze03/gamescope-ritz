#version 460

// cs_effects_layer0.comp -- the bundled "Shaders" area effects (Shadow
// Control, Saturation, Vibrancy, Pre-Sharpen, Bloom, Adaptive Brightness,
// Adaptive Gamma) as one native compute pre-pass over the base/game layer, at
// source resolution,
// before any scaling. Compiled at BUILD time by src/meson.build's glsl_generator into
// cs_effects_layer0.h -- a GLSL error here fails the build, which is the
// whole point of this port (superdoc/planning/DECISIONS.md #27): the
// previous ReShade .fx was compiled at runtime from whichever copy won a
// four-directory search, and a stale copy silently dropped every uniform it
// did not declare. There is nothing on disk to drift any more.
//
// ENCODED SPACE, ON PURPOSE. The host binds the input via its raw UNORM view
// (CVulkanCmdBuffer::setTextureSrgb(0, true) -> CVulkanTexture::srgbView(),
// which despite the name means "values still sRGB-encoded") and the target's
// storage view is UNORM too, so this pass reads and writes gamma-encoded
// 0..1 code values -- exactly the space the .fx it replaces worked in (the
// ReShade loader bound inImage->view(false), the same UNORM view). The
// composite shaders downstream degamma as they always did. Every effect
// below is SDR-only (DECISIONS.md #15); the host skips this dispatch for
// HDR/scRGB/passthru layers, so no linear-light or PQ value reaches pow().
//
// The maths is ported 1:1 from the retired reshade/Shaders/gamescope-ritz.fx
// (ApplyShadowLift, ApplyVibrancy, PS_AdaptiveBrightnessApply) with one
// deliberate substitution: Pre-Sharpen reuses FSR1's RCAS (ffx_fsr1.h)
// instead of the .fx's plain 4-tap unsharp mask. Same 5-tap cross, but RCAS
// is clip-aware (its lobe is limited so a sharpened value cannot overshoot
// the local min/max ring) and normalised, so it does not ring on hard edges
// the way the unsharp mask did at strength > 1. See
// superdoc/features/shader-effects.md for the slider -> con.x mapping the
// host applies.
//
// The uniform block, flag bits and the per-tap grade() live in
// effects_common.h, shared with cs_effects_measure.comp (Adaptive
// Brightness's measure/adapt pass, dispatched just before this one).

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"
#include "effects_common.h"
#include "effects_curve.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

// 3. Pre-Sharpen via RCAS. FsrRcasLoadF is the only place the source is
//    read, so grading here means every one of RCAS's five taps is graded.
//    Taps are clamped to the image so the edge rows never texelFetch out of
//    bounds (undefined without robustness).
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
vec4 FsrRcasLoadF(ivec2 p)
{
    ivec2 sz = textureSize(s_samplers[0], 0);
    p = clamp(p, ivec2(0), sz - ivec2(1));
    vec4 t = texelFetch(s_samplers[0], p, 0);
    return vec4(grade(t.rgb), t.a);
}
// Input is already sRGB-encoded (see the file header) -- same as
// cs_composite_rcas.comp, no transform.
void FsrRcasInputF(inout float r, inout float g, inout float b) {}
#include "ffx_fsr1.h"

void main()
{
    uvec2 pos  = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(textureSize(s_samplers[0], 0));
    if (any(greaterThanEqual(pos, size)))
        return;

    vec3 c;
    if ((u_flags & EFFECT_PRE_SHARPEN) != 0u)
        FsrRcasF(c.r, c.g, c.b, pos, uvec4(u_rcasCon, 0u, 0u, 0u));
    else
        c = FsrRcasLoadF(ivec2(pos)).rgb;

    // 4. Bloom (NEW 2026-09-08): the glow. Everything expensive already
    //    happened -- three dispatches built an eighth-resolution buffer of
    //    the blurred bright pass (cs_effects_bloom_down.comp, then
    //    effects_bloom_blur.h horizontally and vertically) -- so all that is
    //    left here is one bilinear read of it and the composite.
    //
    //    SCREEN, NOT ADD, and Intensity as an exponent on the transmitted
    //    light rather than a multiplier on the glow:
    //      out = 1 - (1 - base) * (1 - glow)^intensity
    //    which maps [0,1] back into [0,1] at EVERY intensity, so adding
    //    light cannot clip -- see effects_curve.h's BLOOM block, including
    //    what the obvious screen(base, glow * intensity) would have done to
    //    the same frames. It also puts the light where it belongs:
    //    the amount added is scaled by the headroom the pixel underneath
    //    still has, so the bright source at the centre of a glow (the thing
    //    a naive additive bloom always blows out) keeps its own value while
    //    the dark field around it takes the light.
    //
    //    WHERE IT SITS, AND WHY HERE. After Pre-Sharpen, before both
    //    adaptive effects. The glow is built from grade()'s output, so it
    //    carries the same colour grade the picture does; it is not sharpened
    //    (a 5-tap cross is invisible after an 8x reduction); and putting it
    //    BEFORE the adaptive block means the adaptive operators treat the
    //    bloomed picture as the picture -- the glow scales with the exposure
    //    they choose instead of floating on top at a fixed level, and
    //    Dynamic's shoulder rolls the added highlights off for free. There
    //    is no feedback: cs_effects_measure.comp reads the RAW base layer
    //    and grades its taps with grade() alone, so the statistics never see
    //    the glow and a brighter frame can never turn its own bloom down.
    if ((u_flags & EFFECT_BLOOM) != 0u)
    {
        vec3 glow = bloom_sample(vec2(pos) + 0.5);
        c = vec3(bloom_apply(c.r, glow.r, u_bloomIntensity),
                 bloom_apply(c.g, glow.g, u_bloomIntensity),
                 bloom_apply(c.b, glow.b, u_bloomIntensity));
    }

    // 5. Adaptive Brightness. The statistics are what cs_effects_measure.comp
    //    wrote to the history THIS frame (the host orders and barriers the
    //    two dispatches); the reset frame writes the measurements directly,
    //    so a fresh texture is never read here, and the measure pass
    //    guarantees every value is finite and in 0..1.
    if ((u_flags & EFFECT_ADAPTIVE_BRIGHTNESS) != 0u)
    {
        float strength = clamp(u_abStrength, 0.0, 1.0);
        if ((u_flags & EFFECT_AB_DYNAMIC) != 0u)
        {
            // Dynamic: effects_curve.h's levels-gain + median gamma + soft
            // shoulder, per channel, from the smoothed percentiles. The two
            // parameters were already recomputed per invocation rather than
            // carried in a texel -- a couple of logs is cheaper than another
            // round trip -- which is what makes LOCAL adaptation nearly
            // free below: the same two calls, different inputs.
            //
            // LOCAL ADAPTATION. A global curve cannot serve a frame that is
            // half dark interior and half bright sky: lifting the interior
            // blows the sky, protecting the sky leaves the interior black.
            // So each pixel's curve is fitted to ITS OWN neighbourhood --
            // the frame's histogram shifted by how bright this part of the
            // frame is relative to the whole (effects_curve.h's
            // ab_local_shift(), the measure pass's 16x16 map). `rEff` is
            // exactly 1.0 when the strength is 0 or the neighbourhood is
            // average, so this is bit-for-bit the old global path in both
            // cases; the branch only skips the four map fetches.
            float rEff = 1.0;
            if (u_abLocal > 0.0)
            {
                float local = ab_local_sample((vec2(pos) + 0.5) / vec2(size));
                rEff = ab_local_shift(local, history_read(HISTORY_MEAN), u_abLocal);
            }
            float gain  = ab_dyn_gain(history_read(HISTORY_P98) * rEff,
                                      history_read(HISTORY_P50) * rEff,
                                      u_abTarget, u_abMin, u_abMax);
            float gamma = ab_dyn_gamma(history_read(HISTORY_P2) * rEff,
                                       history_read(HISTORY_P50) * rEff,
                                       gain, u_abTarget, u_abMin, u_abMax);
            vec3 graded = vec3(ab_dyn_curve(c.r, gain, gamma),
                               ab_dyn_curve(c.g, gain, gamma),
                               ab_dyn_curve(c.b, gain, gamma));
            c = mix(c, graded, strength);
        }
        else
        {
            // Whole image: the .fx's PS_AdaptiveBrightnessApply, 1:1 -- one
            // gain that pulls the smoothed mean toward the target, clamped
            // to the min/max bounds. The max(., 0.001) guards the divide.
            float adapted = history_read(HISTORY_MEAN);
            float gain = clamp(u_abTarget / max(adapted, 0.001), u_abMin, u_abMax);
            c = mix(c, c * gain, strength);
        }
    }

    // 6. Adaptive Gamma (NEW 2026-09-08). The same smoothed statistics, and
    //    ONE exponent: no levels gain, no shoulder, no white point. For an
    //    encoded value in 0..1 a pure exponent lands back in 0..1 with 0 and
    //    1 as exact fixed points, so this operator cannot clip at any
    //    setting and needs nothing to protect the highlights -- see
    //    effects_curve.h's ADAPTIVE GAMMA block for the full argument and
    //    for why its two bounds are the user's own params.
    //
    //    Local adaptation is the SAME operator Adaptive Brightness uses
    //    (ab_local_shift over the measure pass's 16x16 map), shifting the
    //    median this pixel's exponent is fitted to. At strength 0 rEff is
    //    exactly 1.0, so this is bit-for-bit the global exponent and the
    //    branch only skips the four map fetches.
    //
    //    The host never sets this bit together with
    //    EFFECT_ADAPTIVE_BRIGHTNESS (both aim the frame's mid-tones at a
    //    target from the same pre-effect statistics, so running both would
    //    apply the correction twice); if a hand-edited config asks for
    //    both, EffectsPushData_t drops this one.
    if ((u_flags & EFFECT_ADAPTIVE_GAMMA) != 0u)
    {
        float rEff = 1.0;
        if (u_agLocal > 0.0)
        {
            float local = ab_local_sample((vec2(pos) + 0.5) / vec2(size));
            rEff = ab_local_shift(local, history_read(HISTORY_MEAN), u_agLocal);
        }
        float gamma = ag_gamma(history_read(HISTORY_P50) * rEff,
                               u_agTarget, u_agMaxLift, u_agMaxDarken);
        vec3 graded = vec3(ag_curve(c.r, gamma),
                           ag_curve(c.g, gamma),
                           ag_curve(c.b, gamma));
        c = mix(c, graded, clamp(u_agStrength, 0.0, 1.0));
    }

    c = clamp(c, 0.0, 1.0);

    imageStore(dst, ivec2(pos), vec4(c, 1.0));
}
