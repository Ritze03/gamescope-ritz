#version 460

// cs_effects_layer0.comp -- the bundled "Shaders" area effects (Shadow
// Control, Vibrancy, Pre-Sharpen, and the seam for Adaptive Brightness) as
// one native compute pre-pass over the base/game layer, at source
// resolution, before any scaling. Compiled at BUILD time by src/meson.build's
// glsl_generator into cs_effects_layer0.h -- a GLSL error here fails the
// build, which is the whole point of this port (superdoc/planning/
// DECISIONS.md #27): the previous ReShade .fx was compiled at runtime from
// whichever copy won a four-directory search, and a stale copy silently
// dropped every uniform it did not declare. There is nothing on disk to
// drift any more.
//
// ENCODED SPACE, ON PURPOSE. The host binds the input via its raw UNORM view
// (CVulkanCmdBuffer::setTextureSrgb(0, true) -> CVulkanTexture::srgbView(),
// which despite the name means "values still sRGB-encoded") and the target's
// storage view is UNORM too, so this pass reads and writes gamma-encoded
// 0..1 code values -- exactly the space the .fx it replaces worked in (the
// ReShade loader bound inImage->view(false), the same UNORM view). The
// composite shaders downstream degamma as they always did. Every effect
// below is SDR-only (DECISIONS.md #15); the host skips this dispatch for
// HDR/scRGB/passthru layers, so no linear-light or PQ value reaches pow().
//
// The maths is ported 1:1 from the retired reshade/Shaders/gamescope-ritz.fx
// (ApplyShadowLift, ApplyVibrancy) with one deliberate substitution: Pre-
// Sharpen reuses FSR1's RCAS (ffx_fsr1.h) instead of the .fx's plain 4-tap
// unsharp mask. Same 5-tap cross, but RCAS is clip-aware (its lobe is
// limited so a sharpened value cannot overshoot the local min/max ring) and
// normalised, so it does not ring on hard edges the way the unsharp mask
// did at strength > 1. See superdoc/features/shader-effects.md for the
// slider -> con.x mapping the host applies.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

// Mirrors EffectsPushData_t in src/rendervulkan.cpp field-for-field -- keep
// the two in step. The u_ab* block is reserved for Adaptive Brightness
// (Agent B) so the layout does not shift under it when it lands.
layout(binding = 0, scalar)
uniform effects_t {
    uint  u_flags;        // EFFECT_* bits below
    float u_vibrancy;     // 0.0..3.0, 1.0 neutral
    float u_shadowLift;   // 0.0..1.0, 0.0 neutral
    uint  u_rcasCon;      // floatBitsToUint(con.x) for FsrRcasF; 0 = no sharpen

    // ---- reserved for Adaptive Brightness (Agent B) ----
    float u_abTarget;     // target luminance, 0.1..0.9
    float u_abUp;         // brighten time constant, seconds
    float u_abDown;       // darken time constant, seconds
    float u_abMin;        // min gain, 0.5..1.0
    float u_abMax;        // max gain, 1.0..2.0
    float u_abStrength;   // dry/wet mix, 0.0..1.0
    float u_abDt;         // frame time, seconds
};

// Bit assignments are the contract with EffectsPushData_t's constructor.
const uint EFFECT_SHADOW_LIFT         = 1u << 0;
const uint EFFECT_VIBRANCY            = 1u << 1;
const uint EFFECT_VIBRANCY_SKIN       = 1u << 2;
const uint EFFECT_PRE_SHARPEN         = 1u << 3;
const uint EFFECT_ADAPTIVE_BRIGHTNESS = 1u << 4;   // reserved for Agent B
const uint EFFECT_RESET_HISTORY       = 1u << 31;  // reserved for Agent B: discard the adapted-luminance history this frame

// Per-tap colour grade: steps 1 and 2 of the effect order, applied to EVERY
// tap RCAS reads (5x a few ALU ops), so the sharpen sees the graded image
// exactly as the .fx's pass order (Shadow Control -> Vibrancy -> Pre-Sharpen)
// did. Both are pure per-pixel operations on one sample, so applying them
// inside the load is equivalent to a separate pass and saves a texture
// round trip.
vec3 grade(vec3 c)
{
    // 1. Shadow Control: a gamma curve on the low end, exponent 1.0
    //    (identity) down to 0.5 (sqrt) at full strength. 0 and 1 are fixed
    //    points of any power curve, so black and white never move.
    if ((u_flags & EFFECT_SHADOW_LIFT) != 0u)
    {
        float e = 1.0 - 0.5 * clamp(u_shadowLift, 0.0, 1.0);
        c = pow(clamp(c, 0.0, 1.0), vec3(e));
    }

    // 2. Vibrancy: `m` alone walks 0.0 (grey) .. 1.0 (unchanged) uniformly;
    //    `boost` carries the adaptive/skin-tone shape only above neutral.
    if ((u_flags & EFFECT_VIBRANCY) != 0u)
    {
        float luma = dot(c, vec3(0.299, 0.587, 0.114));
        float sat  = max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b));
        float skin = 0.0;
        if ((u_flags & EFFECT_VIBRANCY_SKIN) != 0u)
        {
            // Warm hues where red clearly leads blue and green sits
            // roughly between them -- a cheap, deliberately approximate
            // skin-tone mask.
            skin = clamp((c.r - c.b) * 3.0, 0.0, 1.0)
                 * clamp(1.0 - abs(c.g - (c.r + c.b) * 0.5) * 4.0, 0.0, 1.0);
        }
        float prot  = mix(1.0, 0.3, skin);
        float m     = min(u_vibrancy, 1.0);
        float boost = max(u_vibrancy - 1.0, 0.0) * (1.0 - sat) * prot;
        c = clamp(mix(vec3(luma), c, m + boost), 0.0, 1.0);
    }

    return c;
}

// 3. Pre-Sharpen via RCAS. FsrRcasLoadF is the only place the source is
//    read, so grading here means every one of RCAS's five taps is graded.
//    Taps are clamped to the image so the edge rows never texelFetch out of
//    bounds (undefined without robustness).
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
vec4 FsrRcasLoadF(ivec2 p)
{
    ivec2 sz = textureSize(s_samplers[0], 0);
    p = clamp(p, ivec2(0), sz - ivec2(1));
    vec4 t = texelFetch(s_samplers[0], p, 0);
    return vec4(grade(t.rgb), t.a);
}
// Input is already sRGB-encoded (see the file header) -- same as
// cs_composite_rcas.comp, no transform.
void FsrRcasInputF(inout float r, inout float g, inout float b) {}
#include "ffx_fsr1.h"

void main()
{
    uvec2 pos  = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(textureSize(s_samplers[0], 0));
    if (any(greaterThanEqual(pos, size)))
        return;

    vec3 c;
    if ((u_flags & EFFECT_PRE_SHARPEN) != 0u)
        FsrRcasF(c.r, c.g, c.b, pos, uvec4(u_rcasCon, 0u, 0u, 0u));
    else
        c = FsrRcasLoadF(ivec2(pos)).rgb;

    // 4. Adaptive Brightness gain -- SEAM FOR AGENT B. The adapted-luminance
    //    history texel is to be bound at s_samplers[VKR_EFFECTS_HISTORY_SLOT]
    //    (descriptor_set_constants.h); B replaces the constant below with
    //    something like
    //      float adapted = texelFetch(s_samplers[VKR_EFFECTS_HISTORY_SLOT], ivec2(0), 0).r;
    //      float gain = (u_flags & EFFECT_ADAPTIVE_BRIGHTNESS) != 0u
    //          ? mix(1.0, clamp(u_abTarget / max(adapted, 0.001), u_abMin, u_abMax), u_abStrength)
    //          : 1.0;
    //    Until then the multiply is by exactly 1.0 and the effect has no
    //    visible result.
    float gain = 1.0;
    c = clamp(c * gain, 0.0, 1.0);

    imageStore(dst, ivec2(pos), vec4(c, 1.0));
}
