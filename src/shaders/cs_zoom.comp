#version 450

// cs_zoom.comp -- the zoom's one dispatch (2026-09-14, superdoc/features/
// zoom.md). Writes the projection texture: for each of its pixels, the base
// layer sampled bilinearly around its centre at u_srcPerDst source texels
// per pixel (layer scale / magnification), masked to the shape, with a
// u_outlinePx-wide black ring just inside the shape's edge and transparent
// black outside it. Premultiplied alpha, encoded in and encoded out: slot 0
// is the raw view of layer 0 (post-effects when any are on) and dst is the
// UNORM view of an ABGR8888 texture the composite then treats as a layer in
// layer 0's own colorspace.
//
// The edge is a signed distance in pixels, so both the shape's boundary
// and the ring's inner edge are antialiased over one pixel; a rectangle's
// distance is exact, a circle's is exact when it is a circle (the host
// makes the circle's texture square), and the ellipse a non-square would
// give is close enough for a 1 px ring.
//
// SHARPEN (2026-09-22, zoom.sharpen, superdoc/features/zoom.md's "Sharpen"
// section) -- the user: "add an option to add a sharpening filter on top of
// the projector area only, so the zoom content doesn't look as blurry as it
// does right now." First cut reused FSR1 RCAS with taps spaced one
// PROJECTOR pixel apart; QC measured that raising edge-gradient energy by
// only +4.3% at the top of the slider, because (a) the blur being fixed
// lives at SOURCE-texel spacing -- a 3x zoom's bilinear ramp is 3 projector
// pixels wide, so a 1-projector-pixel tap barely sees it -- and (b) RCAS's
// negative lobe is capped at FSR_RCAS_LIMIT (0.1875) by design, a mild
// post-upscale touch-up rather than a de-blur.
//
// This is a plain contrast-clamped unsharp mask instead, with its taps
// spaced ONE SOURCE TEXEL apart (uv +/- 1/textureSize per axis) -- the scale
// the blur actually lives at -- and a per-channel clamp of the result to
// the local FULL 3x3-source-texel neighbourhood's own min/max (all 8
// surrounding taps, not just the 4 orthogonal ones -- a 4-tap cross clamp
// measured a lower ceiling, see zoom.md). That clamp is what makes a large
// amount safe: the result can never leave the range already present in the
// neighbourhood, so there is no ringing and no new dark/bright fringe, only
// a steeper edge. u_sharpenAmount == 0.0 (off) branches around the whole
// unsharp-mask block, so the shader is byte-identical to before this
// feature existed whenever the slider is at its default.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

// == rendervulkan.cpp's ZoomPushData_t, field for field.
layout(binding = 0, scalar)
uniform zoom_t {
    vec2  u_srcCenter;   // source texel of the projection's centre
    vec2  u_srcPerDst;   // source texels per projection pixel
    uvec2 u_size;        // the projection, pixels
    uint  u_circle;
    uint  u_outlinePx;
    // Unsharp-mask amount, already mapped from the 0..1 UI slider by a
    // nonlinear curve (Zoom_SharpenAmount(), Overlay/Zoom.h -- the shader
    // only ever sees the resulting shader-units amount, never the raw
    // slider value). 0.0 (the exact float, no bit tricks needed since
    // nothing here packs it for FFX's uint-SIMD macros any more) means off.
    float u_sharpenAmount;
};

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= u_size.x || p.y >= u_size.y)
        return;

    vec2 halfSize = vec2(u_size) * 0.5;
    vec2 d = vec2(p) + 0.5 - halfSize;   // from the centre, pixels

    float edge;   // signed distance to the shape's boundary, px, negative inside
    if (u_circle != 0u)
        edge = (length(d / halfSize) - 1.0) * min(halfSize.x, halfSize.y);
    else
    {
        vec2 q = abs(d) - halfSize;
        edge = max(q.x, q.y);
    }

    float inside = clamp(0.5 - edge, 0.0, 1.0);                         // coverage of the shape
    float fill   = clamp(0.5 - (edge + float(u_outlinePx)), 0.0, 1.0);  // coverage of the picture inside the ring

    vec2 texSize = vec2(textureSize(s_samplers[0], 0));
    vec2 uv = (u_srcCenter + d * u_srcPerDst) / texSize;

    // Sharpen applied BEFORE fill/alpha, so the ring's own antialiasing and
    // the outline are untouched by it -- only the picture inside is ever
    // fed through the unsharp mask. When off, this is byte-for-byte the
    // pre-2026-09-22 fetch: the branch is skipped entirely, not a no-op
    // unsharp-mask call.
    vec3 rgb;
    if (u_sharpenAmount != 0.0)
    {
        vec2 texel = 1.0 / texSize;   // one SOURCE texel, in uv units
        vec3 c  = textureLod(s_samplers[0], uv, 0).rgb;
        vec3 n  = textureLod(s_samplers[0], uv + vec2( 0.0, -texel.y), 0).rgb;
        vec3 s_ = textureLod(s_samplers[0], uv + vec2( 0.0,  texel.y), 0).rgb;
        vec3 e  = textureLod(s_samplers[0], uv + vec2( texel.x, 0.0), 0).rgb;
        vec3 w  = textureLod(s_samplers[0], uv + vec2(-texel.x, 0.0), 0).rgb;
        vec3 ne = textureLod(s_samplers[0], uv + vec2( texel.x, -texel.y), 0).rgb;
        vec3 nw = textureLod(s_samplers[0], uv + vec2(-texel.x, -texel.y), 0).rgb;
        vec3 se = textureLod(s_samplers[0], uv + vec2( texel.x,  texel.y), 0).rgb;
        vec3 sw = textureLod(s_samplers[0], uv + vec2(-texel.x,  texel.y), 0).rgb;

        vec3 blur = (n + s_ + e + w + ne + nw + se + sw) * 0.125;
        rgb = c + u_sharpenAmount * (c - blur);

        // Per-channel clamp to the FULL 3x3-source-texel neighbourhood's own
        // min/max (matching how "no halo" is measured -- see zoom.md): the
        // result can never fall outside what was already there, so no
        // overshoot -- no halos -- no matter how large u_sharpenAmount is.
        vec3 lo = min(c, min(min(min(n, s_), min(e, w)), min(min(ne, nw), min(se, sw))));
        vec3 hi = max(c, max(max(max(n, s_), max(e, w)), max(max(ne, nw), max(se, sw))));
        rgb = clamp(rgb, lo, hi);
    }
    else
    {
        rgb = textureLod(s_samplers[0], uv, 0).rgb;
    }

    imageStore(dst, ivec2(p), vec4(rgb * fill, inside));
}
