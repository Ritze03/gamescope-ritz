#version 460

// cs_fg_crosshair_patch.comp -- frame generation's crosshair protection,
// restore half (src/FrameGen/FrameGenHost.cpp, superdoc/features/
// frame-generation.md "Crosshair protection"). After the library has written
// a generated frame, paints the saved original crosshair pixels back over it:
//     out = mix(out, patch.rgb, patch.a)
// over the centred ROI. Because a generated frame is cached per (pair, k),
// every repaint of it keeps the crosshair for free.
//
//   slot 0 = the patch texture (ROI-sized): .rgb original pixels, .a mask
//   dst    = the generated frame (full frame), READ as well as written, which
//            is why this file does not use descriptor_set.h (its `dst` is
//            writeonly): each invocation touches only its own texel, so the
//            same-image load/store is race-free.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set_constants.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

// == FrameGenHost.cpp's XhairPush_t (only u_origin / u_size are used here).
layout(binding = 0, scalar)
uniform xhair_t {
    ivec2 u_origin;
    ivec2 u_size;
    float u_thr;
    uint  u_k;
    uint  u_reset;
    uint  u_mode;
};

layout(binding = 1, rgba8) uniform image2D dst;
layout(binding = 3) uniform sampler2D s_samplers[VKR_SAMPLER_SLOTS];

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, u_size)))
        return;

    vec4 pt = texelFetch(s_samplers[0], p, 0);
    if (pt.a == 0.0)
        return;

    ivec2 q = u_origin + p;
    vec3 o = imageLoad(dst, q).rgb;
    imageStore(dst, q, vec4(mix(o, pt.rgb, pt.a), 1.0));
}
