{
    "file_format_version" : "1.0.0",
    "layer" : {
      "name": "@layer_name@_@family@",
      "type": "GLOBAL",
      "api_version": "1.3.221",
      "library_path": "@lib_dir@/lib@layer_file@_@family@.so",
      "implementation_version": "1",
      "description": "@layer_desc@ (@family@)",
      "functions": {
         "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
      },
      "enable_environment": {
        "@enable_env@": "1"
      },
      "disable_environment": {
        "@disable_env@": "1"
      }
    }
}
